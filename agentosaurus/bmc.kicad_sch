  (text "ESP32-S3 BMC (Baseboard Management Controller)" (at 60.96 35.56 0)
    (effects (font (size 3.81 3.81) bold) (justify left bottom))
    (uuid b2000060-0001-4000-8000-000000000001)
  )

  (text "GPIO Assignments:\n  IO4-IO7: Slot 1-4 power enable (TPS22918 EN)\n  IO8: UART mux S0 / USB mux select A\n  IO9: UART mux S1 / USB mux select B\n  IO17: UART TX (to mux 1Z)\n  IO18: UART RX (to mux 2Z)\n  IO19: USB D- (USB-OTG)\n  IO20: USB D+ (USB-OTG)\n  IO21: WS2812B data out\n  IO6/IO7: I2C SDA/SCL" (at 60.96 40.64 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b2000060-0002-4000-8000-000000000001)
  )

  (text "USB-C Management Port" (at 30.48 50.8 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid b2000060-0003-4000-8000-000000000001)
  )
  (text "CC1/CC2: 5.1k to GND (UFP/sink)\nD+/D- through USBLC6-2SC6 ESD to ESP32 IO19/IO20" (at 30.48 55.88 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b2000060-0004-4000-8000-000000000001)
  )

  (text "UART Mux (SN74LV4052A)" (at 213.36 55.88 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid b2000060-0005-4000-8000-000000000001)
  )
  (text "Dual 4:1 analog mux\n1Z = ESP32 TX -> 1Y0-3 = Slot 1-4 TX\n2Z = ESP32 RX <- 2Y0-3 = Slot 1-4 RX\nS0/S1 from ESP32 GPIO8/9" (at 213.36 60.96 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b2000060-0006-4000-8000-000000000001)
  )

  (text "TPS22918 Per-Slot Load Switches" (at 213.36 132.08 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid b2000060-0007-4000-8000-000000000001)
  )
  (text "VIN=5V, VOUT per slot\nEN from ESP32 GPIO4-7\nCT: 10nF rise-time control\nCin=1uF, Cout=10uF per switch" (at 213.36 137.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b2000060-0008-4000-8000-000000000001)
  )

  (text "WS2812B Status LEDs (cascaded)" (at 213.36 180.34 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid b2000060-0009-4000-8000-000000000001)
  )
  (text "DIN chain from ESP32 IO21\nVDD=5V, 100nF per LED\nD1->D2->D3->D4" (at 213.36 185.42 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b2000060-0010-4000-8000-000000000001)
  )

  (text "TS3USB221 USB Muxes" (at 152.4 63.5 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid b2000060-0011-4000-8000-000000000001)
  )
  (text "U4: Slot 1/2 USB -> ESP32\nU5: Slot 3/4 USB -> ESP32\nSelect from ESP32 GPIO\nFor eMMC flashing" (at 152.4 68.58 0)
